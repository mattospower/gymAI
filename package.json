{
  "name": "gymia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "build": "node scripts/build-vercel.mjs",
    "test:deploy": "node --test tests/deploy.smoke.mjs",
    "test:e2e:postgres": "node scripts/e2e-postgres.mjs"
  },
  "dependencies": {
    "nodemailer": "10.1.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "1.64.1"
  }
}
