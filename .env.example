NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# Execute npm run setup para gerar uma chave local. Nunca envie a chave ao GitHub.
DATA_ENCRYPTION_KEY=
DATABASE_PATH=./data/gymia.sqlite
# Recuperação de senha só fica disponível com TODOS os campos SMTP preenchidos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# O padrão demo é local, editorial e não chama modelos ou serviços pagos.
AI_PROVIDER=demo
# Para OpenAI, configure explicitamente todos os campos e autorize os custos.
AI_ALLOW_PAID=false
OPENAI_API_KEY=
# Modelo disponível na sua conta, compatível com Responses + Structured Outputs.
AI_MODEL=

# PostgreSQL na Vercel: URL com pool e TLS verificado; vazio mantém SQLite local.
DATABASE_URL=
# Chave separada para backups criptografados, nunca no navegador.
BACKUP_ENCRYPTION_KEY=
